    <string name="windows_tool_title">כלי Windows</string>
    <string name="windows_tool_intro">כאן מנהלים את החיבור למחשב: גיבוי מלא של כל נתוני האפליקציה (כולל קיצורים), וייבוא/ייצוא של ספרים והתאמות כקובצי אקסל. בכל ייבוא נשמר אוטומטית גיבוי מלא לפני השינוי, כך שתמיד אפשר לחזור אחורה.</string>

    <string name="windows_tool_backup_section">גיבוי מלא</string>
    <string name="windows_tool_backup_desc">יוצר קובץ zip בתיקיית Download של הטאבלט (נראה מהמחשב). הקובץ כולל את כל הנתונים — ספרים, קיצורים, התאמות, בקשות, תמיכה והודעות — גם בפורמט קריא לצפייה וגם בפורמט שניתן לשחזר ממנו בדיוק.</string>
    <string name="windows_tool_backup_now">צור גיבוי עכשיו</string>
    <string name="windows_tool_backup_last">גיבוי אחרון: %1$s</string>
    <string name="windows_tool_backup_never">עדיין לא נוצר גיבוי</string>
    <string name="windows_tool_backup_done">הגיבוי נשמר: %1$s (בתיקיית Download)</string>
    <string name="windows_tool_backup_failed">הגיבוי נכשל: %1$s</string>

    <string name="windows_tool_books_section">ספרים</string>
    <string name="windows_tool_books_format">עמודות: שם הספר · ענינים · המחבר · מספר · אות · צבע · קטגוריה · תת קטגוריה · הערות. השורה הראשונה היא כותרות.\n\nייבוא מוסיף רק ספרים חדשים. אם שם + מחבר + אות + מספר + קטגוריה וכו\' תואמים לספר שכבר על הטאבלט — השורה תדולג (לא שגיאה). ייצוא ואז ייבוא של אותו קובץ = 0 חדשים.</string>
    <string name="windows_tool_matchings_section">התאמות חיפוש (מילים נרדפות)</string>
    <string name="windows_tool_matchings_format">עמודות: קיצור · מילים · כיוון. ב״מילים״ ניתן לרשום כמה מילים מלאות מופרדות בפסיק. ״כיוון״: דו-כיווני או חד-כיווני (ברירת מחדל: דו-כיווני).\n\nייבוא מוסיף קיצורים חדשים ומעדכן מילים/כיוון לקיצור שכבר קיים. שורות זהות ללא שינוי — ללא פעולה.</string>

