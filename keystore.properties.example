# Copy this file to "keystore.properties" (same folder) and fill in real values.
# keystore.properties is git-ignored on purpose — it holds signing secrets.
#
# storeFile   = absolute path to your .jks keystore (e.g. /Users/you/library-release.jks)
# storePassword = the keystore (store) password you chose with keytool
# keyAlias    = the key alias (e.g. library)
# keyPassword = the key password you chose with keytool
#
# IMPORTANT: back up the .jks file AND these passwords. Sealed tablets can only
# be updated with an APK signed by this exact key, and they cannot be uninstalled.

storeFile=/absolute/path/to/library-release.jks
storePassword=CHANGE_ME
keyAlias=library
keyPassword=CHANGE_ME
