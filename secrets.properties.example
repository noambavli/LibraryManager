# LibraryManager app secrets — copy this file to `secrets.properties` and fill
# in the real values. `secrets.properties` is git-ignored and must NEVER be
# committed. These values are injected into the build (BuildConfig) so no
# password is ever hardcoded in the Kotlin source.

# Developer key: the ONLY credential that opens the in-app "Developer dashboard".
# APKs can be installed/updated ONLY from that dashboard — regular management
# cannot install anything. Keep this private.
#
# This plaintext value stays in secrets.properties and is NEVER shipped: the
# build embeds only a salted SHA-256 hash of it in the APK, so decompiling the
# installed app cannot reveal this key. (Numeric only — it is entered on a
# numeric on-screen keypad.)
devKey=64426442

# Default management password. The management password gate accepts this value
# out of the box, and "reset password" in the developer dashboard restores it.
# It ships as 1111 and can be changed at runtime from the developer dashboard.
managementDefaultPassword=1111
